<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlowDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlowDesk.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    }
    <div class="fd-shell">
        <header class="fd-header">
            <div class="fd-container fd-header-inner">
                <a class="fd-brand" asp-controller="Home" asp-action="Index"
                   aria-label="FlowDesk - صفحه اصلی">
                    <span class="fd-brand-logo" aria-hidden="true">F</span>
                    <span class="fd-brand-copy">
                        <strong>FlowDesk</strong>
                        <small>مدیریت پروژه و کارهای تیم</small>
                    </span>
                </a>

                <nav class="fd-navigation" aria-label="ناوبری اصلی">
                    <a class="fd-nav-link @(currentController == "Projects" || currentController == "ProjectMembers" ? "is-active" : "")"
                       asp-controller="Projects" asp-action="Index">پروژه‌ها</a>
                    <a class="fd-nav-link @(currentController == "WorkItems" && ViewContext.RouteData.Values["action"]?.ToString() != "Assign" ? "is-active" : "")"
                       asp-controller="WorkItems" asp-action="Index">تسک‌ها</a>
                    <a class="fd-nav-link @(currentController == "WorkItems" && ViewContext.RouteData.Values["action"]?.ToString() == "Assign" ? "is-active" : "")"
                       asp-controller="WorkItems" asp-action="Assign">واگذاری تسک</a>
                    <a class="fd-nav-link @(currentController == "TeamMembers" ? "is-active" : "")"
                       asp-controller="TeamMembers" asp-action="Index">اعضای تیم</a>
                </nav>
            </div>
        </header>

        <main class="fd-main" role="main">
            <div class="fd-container">
                @RenderBody()
            </div>
        </main>

        <footer class="fd-footer">
            <div class="fd-container fd-footer-inner">
                <span>FlowDesk</span>
                <span class="fd-footer-separator" aria-hidden="true">•</span>
                <span>مدیریت پروژه و کارهای تیم</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
