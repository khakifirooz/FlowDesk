@using FlowDesk.Application.Common
@using FlowDesk.Infrastructure.Identity
@inject ProjectAccess WorkspaceAccess
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> AccountManager

@{
    string? currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    bool dashboardActive = currentController == "Dashboard";

    bool projectsActive =
        currentController is "Projects" or "ProjectMembers";

    bool tasksActive = currentController == "WorkItems";

    bool membersActive =
        currentController == "TeamMembers";

    bool signedIn = User.Identity?.IsAuthenticated == true;
    var account = signedIn ? await AccountManager.GetUserAsync(User) : null;
    bool canManageProjects = account is not null && (await WorkspaceAccess.GetViewScopeAsync()).ManagedProjectIds.Count > 0;
    bool myTasksActive = tasksActive &&
        bool.TryParse(Context.Request.Query["OnlyMine"], out bool onlyMine) && onlyMine;
    string displayName = account is not null && !string.IsNullOrWhiteSpace(account.FullName)
        ? account.FullName
        : "حساب کاربری";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | FlowDesk</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <a class="skip-link" href="#main-content">
        رفتن به محتوای صفحه
    </a>

    <header class="app-header">
        <nav class="navbar navbar-expand-xl"
             aria-label="منوی اصلی">

            <div class="container">
                <a class="navbar-brand brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-mark" aria-hidden="true">
                        F
                    </span>

                    <span>
                        <b dir="ltr">FlowDesk</b>
                        <small>مدیریت پروژه و کارهای تیم</small>
                    </span>
                </a>

                @if (signedIn)
                {
                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#main-nav"
                            aria-controls="main-nav"
                            aria-expanded="false"
                            aria-label="باز کردن منو">

                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="main-nav">
                        <div class="navbar-nav ms-auto gap-xl-1">

                            @if (canManageProjects)
                            {
                                <a class="nav-link @(dashboardActive ? "active" : "")"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               aria-current="@(dashboardActive ? "page" : null)">
                                    داشبورد
                                </a>
                            }

                            <a class="nav-link @(projectsActive ? "active" : "")"
                               asp-controller="Projects"
                               asp-action="Index"
                               aria-current="@(projectsActive ? "page" : null)">
                                پروژه‌ها
                            </a>

                            <a class="nav-link @(tasksActive && !myTasksActive ? "active" : "")"
                               asp-controller="WorkItems"
                               asp-action="Index"
                               aria-current="@(tasksActive && !myTasksActive ? "page" : null)">
                                تسک‌ها
                            </a>

                            <a class="nav-link @(myTasksActive ? "active" : "")"
                               asp-controller="WorkItems" asp-action="Index" asp-route-OnlyMine="true"
                               aria-current="@(myTasksActive ? "page" : null)">تسک‌های من</a>

                            @if (canManageProjects)
                            {
                                <a class="nav-link @(membersActive ? "active" : "")"
                                   asp-controller="TeamMembers"
                                   asp-action="Index"
                                   aria-current="@(membersActive ? "page" : null)">
                                    فهرست افراد تیم
                                </a>
                            }

                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-3 mt-3 mt-xl-0">
                            <span class="small text-muted text-break">
                                <bdi>@displayName</bdi>
                            </span>

                            <form asp-controller="Account" asp-action="Logout"
                                  method="post" class="m-0" data-prevent-double-submit>
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    خروج
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary ms-auto"
                       asp-controller="Account" asp-action="Login">
                        ورود
                    </a>
                }
            </div>
        </nav>
    </header>

    <main id="main-content" class="container app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            <span dir="ltr">FlowDesk</span>
            <span class="footer-separator" aria-hidden="true">•</span>
            مدیریت پروژه و کارهای تیم
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>