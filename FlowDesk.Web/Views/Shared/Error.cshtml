@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}
<section class="panel panel-pad form-panel">
    <span class="eyebrow">FlowDesk</span>
    <h1>درخواست انجام نشد</h1>
    <p>یک خطای پیش‌بینی‌نشده رخ داد. دوباره تلاش کنید یا به صفحهٔ اصلی برگردید.</p>
    @if (Model.ShowRequestId)
    {
        <p>شناسهٔ پیگیری: <code dir="ltr">@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">بازگشت به خانه</a>
</section>
