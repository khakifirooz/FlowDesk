@model FlowDesk.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "ورود";
    var acceptPath = Url.Action("Accept", "ProjectInvitations");
    bool fromInvitation = acceptPath is not null && Url.IsLocalUrl(Model.ReturnUrl) &&
        Model.ReturnUrl!.StartsWith(acceptPath + "?", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="auth-shell auth-shell-split">
    <section class="auth-panel panel panel-pad auth-form-panel" aria-labelledby="account-form-title">
        <header class="account-form-head">
            <h1 id="account-form-title">ورود</h1>
            <p>برای دیدن پروژه‌ها و تسک‌های خود، با ایمیل و رمز عبور وارد شوید.</p>
        </header>

        @if (fromInvitation)
        {
            <p class="alert alert-info mb-3">با همان ایمیلی وارد شوید که مدیر پروژه برای دعوت وارد کرده است. بعد از ورود، صفحهٔ پذیرش دعوت باز می‌شود.</p>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post"
              data-prevent-double-submit>

            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       autocomplete="username"
                       dir="ltr"
                       maxlength="256" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password"
                       class="form-control"
                       autocomplete="current-password"
                       dir="ltr"
                       maxlength="128" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe"
                       class="form-check-input" />
                <label asp-for="RememberMe"
                       class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                ورود به حساب
            </button>

            <p class="account-form-footer">
                حساب ندارید؟
                <a asp-action="Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    ساخت حساب
                </a>
            </p>
        </form>
    </section>

    <partial name="_AccountShowcase" />
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}