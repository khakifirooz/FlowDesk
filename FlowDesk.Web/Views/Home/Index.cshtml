@{
    ViewData["Title"] = "خانه";
}

<section class="hero mb-4">
    <span class="eyebrow">
        فضای کاری تیم شما
    </span>

    <h1>از برنامه تا انجام کار.</h1>

    <p class="mt-3 mb-4">
        پروژه‌ها را بسازید، اعضای تیم را کنار هم قرار دهید
        و مسئول هر تسک را مشخص کنید.
        وضعیت کارهای تیم را در یک جا دنبال کنید.
    </p>

    <a asp-controller="Projects"
       asp-action="Index"
       class="btn btn-light">
        مشاهدهٔ پروژه‌ها
    </a>
</section>

<div class="row g-3">
    <div class="col-md-4">
        <article class="panel feature-card">
            <span class="eyebrow">۰۱ / برنامه‌ریزی</span>

            <h2>پروژه‌ها</h2>

            <p>
                برای هر پروژه نام مشخص و تیم مناسب انتخاب کنید.
            </p>

            <a asp-controller="Projects"
               asp-action="Create">
                ایجاد پروژه ←
            </a>
        </article>
    </div>

    <div class="col-md-4">
        <article class="panel feature-card">
            <span class="eyebrow">۰۲ / همکاری</span>

            <h2>اعضای تیم</h2>

            <p>
                افراد را ثبت کنید و به پروژه‌های مربوط اضافه کنید.
            </p>

            <a asp-controller="TeamMembers"
               asp-action="Index">
                مشاهدهٔ اعضا ←
            </a>
        </article>
    </div>

    <div class="col-md-4">
        <article class="panel feature-card">
            <span class="eyebrow">۰۳ / پیگیری</span>

            <h2>تسک‌ها و مسئولیت‌ها</h2>

            <p>
                مسئول را انتخاب کنید و وضعیت انجام هر کار را ببینید.
            </p>

            <a asp-controller="WorkItems"
               asp-action="Index">
                مشاهدهٔ تسک‌ها ←
            </a>
        </article>
    </div>
</div>