@model FlowDesk.Web.ViewModels.Home.WorkspaceHomeViewModel

@{
    ViewData["Title"] = "خانه";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@if (Model is { } workspace)
{
    <div class="page-head workspace-welcome workspace-welcome-brief">
        <div>
            <h1>@(workspace.ManagesProjects || workspace.BelongsToProject ? "نمای کلی کارها" : "شروع کار با FlowDesk")</h1>
            <p>@(workspace.ManagesProjects ? "پروژه‌های تحت مدیریت و کارهایی که نیاز به پیگیری دارند، در دسترس شماست."
                : workspace.BelongsToProject ? "تسک‌های واگذارشده به شما و پروژه‌هایی که در آن‌ها عضو هستید، از اینجا در دسترس‌اند."
                : "پروژهٔ اولتان را بسازید یا با دعوت‌نامه به یک پروژه بپیوندید.")</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-3">
        @if (workspace.BelongsToProject)
        {
            <div class="col">
                <section class="panel panel-pad workspace-tile h-100">
                    <span class="tile-icon"><partial name="_FlowIcon" model='"personal"' /></span>
                    <h2>تسک‌های من</h2>
                    <p>تسک‌هایی که به شما واگذار شده‌اند.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="WorkItems" asp-action="Index" asp-route-OnlyMine="true" class="btn btn-primary">مشاهدهٔ تسک‌های من</a>
                        <a asp-controller="WorkItems" asp-action="Index" asp-route-OnlyMine="true" asp-route-Focus="Overdue" class="btn btn-outline-secondary">گذشته از موعد</a>
                    </div>
                </section>
            </div>
        }
        @if (workspace.ManagesProjects)
        {
            <div class="col">
                <section class="panel panel-pad workspace-tile h-100">
                    <span class="tile-icon"><partial name="_FlowIcon" model='"dashboard"' /></span>
                    <h2>مدیریت پروژه‌ها</h2>
                    <p>پیشرفت پروژه‌ها، مهلت‌ها و کارهای نیازمند پیگیری را ببینید.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">داشبورد مدیریتی</a>
                        <a asp-controller="WorkItems" asp-action="Create" class="btn btn-outline-secondary">ایجاد تسک</a>
                    </div>
                </section>
            </div>
        }
        @if (workspace.ManagesProjects || workspace.BelongsToProject)
        {
            <div class="col">
                <section class="panel panel-pad workspace-tile h-100">
                    <span class="tile-icon"><partial name="_FlowIcon" model='"projects"' /></span>
                    <h2>پروژه‌های من</h2>
                    <p>تسک‌ها و اعضای هر پروژه را یک‌جا ببینید.</p>
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-outline-primary">دیدن پروژه‌ها</a>
                </section>
            </div>
        }
        else
        {
            <div class="col">
                <section class="panel panel-pad workspace-tile h-100">
                    <span class="tile-icon"><partial name="_FlowIcon" model='"projects"' /></span>
                    <h2>ایجاد اولین پروژه</h2>
                    <p>پس از ساخت پروژه، اعضا را اضافه کنید و تسک‌ها را به آن‌ها بسپارید.</p>
                    <a asp-controller="Projects" asp-action="Create" class="btn btn-primary">ایجاد پروژه</a>
                </section>
            </div>
            <div class="col">
                <section class="panel panel-pad workspace-tile h-100">
                    <span class="tile-icon"><partial name="_FlowIcon" model='"team"' /></span>
                    <h2>به پروژه‌ای دعوت شده‌اید؟</h2>
                    <p class="mb-0">لینک مدیر پروژه را باز کنید و با همین حساب دعوت را بپذیرید.</p>
                </section>
            </div>
        }
    </div>
    return;
}

<div class="landing">
    <section class="landing-hero" aria-labelledby="landing-title">
        <div class="landing-intro">
            <span class="landing-kicker"><span aria-hidden="true"></span> فضای کار تیمی</span>
            <h1 id="landing-title">کار تیم،<br /><em>در یک نگاه.</em></h1>
            <p>پروژه‌ها، مسئول هر کار و مهلت‌ها را یک‌جا ببینید؛ از اولین تسک تا تحویل.</p>
            <div class="landing-actions">
                <a asp-controller="Projects" asp-action="Create" class="btn btn-primary">
                    ایجاد پروژه <partial name="_FlowIcon" model='"arrow"' />
                </a>
                <a href="#workspace-preview" class="btn btn-outline-secondary">دیدن نمونهٔ محیط</a>
            </div>
        </div>

        <section id="workspace-preview" class="preview-board" tabindex="-1" aria-labelledby="workspace-preview-title">
            <header class="preview-top">
                <div class="tile-icon"><partial name="_FlowIcon" model='"projects"' /></div>
                <div>
                    <span class="preview-caption">پروژهٔ فرضی</span>
                    <h2 id="workspace-preview-title">طراحی فروشگاه</h2>
                </div>
                <span class="preview-tag">نمونه</span>
            </header>
            <div class="preview-meter">
                <div><span>پیشرفت پروژه</span><strong>۱ از ۳</strong></div>
                <progress value="1" max="3" aria-label="یک تسک از سه تسک انجام شده">۱ از ۳</progress>
            </div>
            <ul class="preview-tasks">
                <li>
                    <span class="status status-done">انجام‌شده</span>
                    <div><h3>تعریف دسته‌بندی‌ها</h3><small>مریم</small></div>
                    <span class="preview-person preview-person-mint" aria-hidden="true">م</span>
                </li>
                <li>
                    <span class="status status-progress">در حال انجام</span>
                    <div><h3>آماده‌سازی سبد خرید</h3><small>امیر</small></div>
                    <span class="preview-person preview-person-amber" aria-hidden="true">ا</span>
                </li>
                <li>
                    <span class="status status-todo">انجام‌نشده</span>
                    <div><h3>طراحی صفحهٔ محصولات</h3><small>نازنین</small></div>
                    <span class="preview-person" aria-hidden="true">ن</span>
                </li>
            </ul>
        </section>
    </section>

    <section class="landing-capabilities" aria-label="امکانات FlowDesk">
        <article>
            <span class="tile-icon"><partial name="_FlowIcon" model='"projects"' /></span>
            <h2>پروژه‌ها</h2>
            <p>تسک‌ها، اعضا و پیشرفت هر پروژه را یک‌جا ببینید.</p>
            <a asp-controller="Projects" asp-action="Index">فهرست پروژه‌ها <partial name="_FlowIcon" model='"arrow"' /></a>
        </article>
        <article>
            <span class="tile-icon tile-icon-alt"><partial name="_FlowIcon" model='"team"' /></span>
            <h2>همکاری تیمی</h2>
            <p>افراد را دعوت کنید و مسئول هر کار را مشخص کنید.</p>
        </article>
        <article>
            <span class="tile-icon tile-icon-warm"><partial name="_FlowIcon" model='"personal"' /></span>
            <h2>پیگیری تسک‌ها</h2>
            <p>مهلت امروز و تسک‌های گذشته از موعد را جداگانه ببینید.</p>
            <a asp-controller="WorkItems" asp-action="Index" asp-route-OnlyMine="true">تسک‌های من <partial name="_FlowIcon" model='"arrow"' /></a>
        </article>
    </section>
</div>
