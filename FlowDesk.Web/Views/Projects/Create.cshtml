@model FlowDesk.Web.ViewModels.Projects.CreateProjectViewModel

@{
    ViewData["Title"] = "ایجاد پروژه";
}

<div dir="rtl" class="container mt-4 text-end">
    <h1 class="mb-4">ایجاد پروژه</h1>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">
            @message
        </div>
    }

    <form asp-controller="Projects"
          asp-action="Create"
          method="post">

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>

            <input asp-for="Name" class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            ثبت پروژه
        </button>
    </form>
</div>