@model FlowDesk.Web.ViewModels.Projects.CreateProjectViewModel

@{
    ViewData["Title"] = "ایجاد پروژه";
}

<div class="page-head">
    <div>
        <span class="eyebrow">پروژه‌ها / پروژهٔ جدید</span>

        <h1>ایجاد پروژه</h1>

        <p>یک نام روشن و متمایز برای پروژه انتخاب کنید.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        بازگشت به فهرست
    </a>
</div>

<section class="panel panel-pad form-panel">
    <form asp-controller="Projects"
          asp-action="Create"
          method="post"
          data-prevent-double-submit>

        <div asp-validation-summary="ModelOnly"></div>

        <div class="mb-4">
            <label asp-for="Name" class="form-label"></label>

            <input asp-for="Name"
                   class="form-control"
                   maxlength="200"
                   placeholder="مثلاً طراحی سایت فروشگاه"
                   autofocus />

            <span asp-validation-for="Name"></span>

            <div class="form-text">
                نام پروژه باید غیرتکراری و حداکثر ۲۰۰ کاراکتر باشد.
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                ایجاد پروژه
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                انصراف
            </a>
        </div>
    </form>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}