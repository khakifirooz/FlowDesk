@model FlowDesk.Web.ViewModels.Projects.EditProjectViewModel

@{
    ViewData["Title"] = "ویرایش پروژه";
}

<div class="page-head">
    <div>
        <span class="eyebrow">پروژه‌ها / ویرایش</span>

        <h1>ویرایش پروژه</h1>

        <p>نام مناسب‌تری برای پروژه انتخاب کنید.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        بازگشت به فهرست
    </a>
</div>

<section class="panel panel-pad form-panel">
    <form asp-controller="Projects"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          data-prevent-double-submit>

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"></div>

        <div class="mb-4">
            <label asp-for="Name" class="form-label"></label>

            <input asp-for="Name"
                   class="form-control"
                   maxlength="200"
                   autofocus />

            <span asp-validation-for="Name"></span>

            <div class="form-text">
                نام انتخاب‌شده نباید متعلق به پروژهٔ دیگری باشد.
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                ذخیرهٔ تغییرات
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                انصراف
            </a>
        </div>
    </form>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}