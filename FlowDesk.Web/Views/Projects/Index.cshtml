@model List<FlowDesk.Web.ViewModels.Projects.ProjectListItemViewModel>

@{
    ViewData["Title"] = "پروژه‌ها";
}

<div dir="rtl" class="container mt-4 text-end">
    <h1 class="mb-4">پروژه‌ها</h1>

    <a asp-controller="Projects"
       asp-action="Create"
       class="btn btn-primary mb-3">
        ایجاد پروژه
    </a>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">
            @message
        </div>
    }

    @if (Model.Count == 0)
    {
        <p>هنوز پروژه‌ای ثبت نشده است.</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>شناسه</th>
                    <th>نام پروژه</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model)
                {
                    <tr>
                        <td>@project.Id</td>
                        <td>@project.Name</td>
                        <td>
                           <a asp-action="Edit"
                              asp-route-id="@project.Id"
                              class="btn btn-sm btn-outline-primary">
                              ویرایش
                          </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>