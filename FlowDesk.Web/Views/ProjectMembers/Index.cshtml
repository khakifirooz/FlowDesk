@using Microsoft.AspNetCore.Mvc.Controllers
@inject Microsoft.AspNetCore.Mvc.Infrastructure.IActionDescriptorCollectionProvider ActionDescriptors
@model FlowDesk.Web.ViewModels.ProjectMembers.ProjectMembersViewModel

@{
    ViewData["Title"] = "اعضای پروژه";
    bool hasInvitations = ActionDescriptors.ActionDescriptors.Items
        .OfType<ControllerActionDescriptor>()
        .Any(action => action.ControllerName == "ProjectInvitations" && action.ActionName == "Create");
}

<div class="page-head">
    <div>
        <span class="eyebrow">پروژه / اعضا</span>
        <h1 class="text-break">@Model.ProjectName</h1>
        <p>فهرست اعضا و گفت‌وگوهای این پروژه را ببینید.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanManageMembers && Model.Members.Count > 0)
        {
            <a asp-controller="WorkItems" asp-action="Create"
               asp-route-projectId="@Model.ProjectId" class="btn btn-primary">ایجاد تسک</a>
            <a asp-controller="WorkItems" asp-action="Assign" asp-route-projectId="@Model.ProjectId"
               class="btn btn-outline-secondary">واگذاری تسک</a>
        }
        <a asp-controller="WorkItems" asp-action="Index"
           asp-route-projectId="@Model.ProjectId" class="btn btn-outline-primary">تسک‌های پروژه</a>

        <a asp-controller="Projects" asp-action="Index"
           class="btn btn-outline-secondary">بازگشت به پروژه‌ها</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div asp-validation-summary="All"></div>

@if (!Model.CanManageMembers)
{
    <p class="alert alert-info">
        می‌توانید اعضا را ببینید و برای آن‌ها دیدگاه بگذارید. مدیریت عضویت فقط در اختیار مدیر پروژه است.
    </p>
}

<div class="row g-4">
    @if (Model.CanManageMembers)
    {
        <div class="col-lg-4">
            <section class="panel panel-pad">
                <h2 class="mb-3">افزودن عضو به پروژه</h2>
                <p class="form-text">
                    پس از افزودن فرد، برای ایمیل او لینک دعوت بسازید. دسترسی پس از تأیید شما برقرار می‌شود.
                </p>

                @if (Model.AvailableMembers.Count > 0)
                {
                    <form asp-action="Add" method="post" data-prevent-double-submit>
                        <input asp-for="ProjectId" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="TeamMemberId" class="form-label"></label>
                            <select asp-for="TeamMemberId" asp-items="Model.AvailableMembers"
                                    class="form-select" required>
                                <option value="0" disabled hidden>انتخاب عضو</option>
                            </select>
                            <span asp-validation-for="TeamMemberId"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            افزودن به پروژه
                        </button>
                    </form>
                }
                else
                {
                    <p>فرد دیگری برای افزودن به پروژه وجود ندارد.</p>
                }
                <a asp-controller="TeamMembers" asp-action="Create" asp-route-projectId="@Model.ProjectId"
                   class="btn btn-outline-primary mt-3">ثبت فرد جدید</a>
            </section>
        </div>
    }

    <div class="@(Model.CanManageMembers ? "col-lg-8" : "col-12")">
        <section class="panel">
            <div class="panel-heading">
                <h2>تیم پروژه</h2>
                <span class="count-pill">@Model.Members.Count نفر</span>
            </div>

            @if (Model.Members.Count == 0)
            {
                <div class="empty-state">
                    <h2>هنوز عضوی به این پروژه اضافه نشده است</h2>
                    @if (Model.CanManageMembers)
                    {
                        <p class="mb-0">برای ساخت اولین تسک، ابتدا دست‌کم یک نفر را به پروژه اضافه کنید.</p>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">نام عضو</th>
                                <th scope="col">گفت‌وگو</th>
                                @if (Model.CanManageMembers)
                                {
                                    <th scope="col">ایمیل</th>
                                    <th scope="col">حساب ورود</th>
                                    <th scope="col">عملیات</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td class="item-title"><bdi>@member.FullName</bdi></td>
                                    <td>
                                        <a asp-controller="ProjectMemberDiscussion" asp-action="Index"
                                           asp-route-projectId="@Model.ProjectId" asp-route-membershipId="@member.Id"
                                           class="btn btn-sm btn-outline-secondary" aria-label="دیدگاه‌ها دربارهٔ @member.FullName">دیدگاه‌ها</a>
                                    </td>

                                    @if (Model.CanManageMembers)
                                    {
                                        var invitation = Model.InvitationStatus.GetValueOrDefault(member.Id);
                                        <td class="text-break">
                                            @if (Model.MemberEmails.TryGetValue(member.Id, out var accountEmail))
                                            {
                                                <bdi dir="ltr">@accountEmail</bdi>
                                            }
                                            else if (!member.HasLinkedAccount && invitation is not null)
                                            {
                                                <bdi dir="ltr">@invitation.InvitedEmail</bdi>
                                                <small class="d-block text-muted">@(invitation.IsPending ? "منتظر تأیید شما" : "منتظر پذیرش دعوت")</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">ثبت نشده</span>
                                            }
                                        </td>
                                        <td>
                                            @if (member.HasLinkedAccount)
                                            {
                                                @if (Model.OwnMembershipIds.Contains(member.Id))
                                                {
                                                    <span class="badge text-bg-success">متصل به حساب شما</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-secondary">متصل به حساب دیگری</span>
                                                }

                                                <form asp-action="UnlinkAccount" method="post" class="mt-2"
                                                      data-confirm="اتصال حساب این عضو از پروژه برداشته شود؟"
                                                      data-prevent-double-submit>
                                                    <input type="hidden" name="projectId"
                                                           value="@Model.ProjectId" />
                                                    <input type="hidden" name="membershipId"
                                                           value="@member.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary">
                                                        قطع اتصال
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="LinkMyAccount" method="post" class="mb-2"
                                                      data-confirm="این ردیف عضو به حساب ورود فعلی شما متصل شود؟"
                                                      data-prevent-double-submit>
                                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                                    <input type="hidden" name="membershipId" value="@member.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">اتصال به حساب من</button>
                                                </form>
                                                @if (hasInvitations)
                                                {
                                                    <a asp-controller="ProjectInvitations" asp-action="Create"
                                                       asp-route-projectId="@Model.ProjectId" asp-route-membershipId="@member.Id"
                                                       class="btn btn-sm btn-outline-secondary mb-2">@(invitation?.IsPending == true ? "بررسی درخواست" : "لینک دعوت")</a>
                                                }
                                            }
                                        </td>

                                        <td>
                                            <form asp-action="Remove" method="post"
                                                  data-confirm="این عضو از پروژه حذف شود؟"
                                                  data-prevent-double-submit>
                                                <input type="hidden" name="projectId"
                                                       value="@Model.ProjectId" />
                                                <input type="hidden" name="membershipId"
                                                       value="@member.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    حذف از پروژه
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (Model.CanManageMembers)
        {
            <p class="form-text mt-3">
                پیش از حذف عضوی که مسئول تسک است، تسک‌های او را به عضو دیگری واگذار کنید.
            </p>
        }
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}