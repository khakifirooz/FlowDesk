@model FlowDesk.Web.ViewModels.ProjectMembers.ProjectMembersViewModel

@{
    ViewData["Title"] = "اعضای پروژه";
}

<div class="page-head">
    <div>
        <span class="eyebrow">پروژه / اعضا</span>

        <h1 class="text-break">@Model.ProjectName</h1>

        <p>اعضای این پروژه را مدیریت کنید.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="WorkItems"
           asp-action="Assign"
           asp-route-id=""
           asp-route-projectId="@Model.ProjectId"
           class="btn btn-primary">
            واگذاری تسک
        </a>

        <a asp-controller="Projects"
           asp-action="Index"
           class="btn btn-outline-secondary">
            بازگشت به پروژه‌ها
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div asp-validation-summary="All"></div>

<div class="row g-4">
    <div class="col-lg-4">
        <section class="panel panel-pad">
            <h2 class="mb-3">افزودن عضو به پروژه</h2>

            @if (Model.AvailableMembers.Count > 0)
            {
                <form asp-controller="ProjectMembers"
                      asp-action="Add"
                      method="post"
                      data-prevent-double-submit>

                    <input asp-for="ProjectId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="TeamMemberId"
                               class="form-label"></label>

                        <select asp-for="TeamMemberId"
                                asp-items="Model.AvailableMembers"
                                class="form-select"
                                required>
                            <option value="0" disabled hidden>
                                انتخاب عضو
                            </option>
                        </select>

                        <span asp-validation-for="TeamMemberId"></span>
                    </div>

                    <p class="form-text">
                        فقط افرادی نمایش داده می‌شوند که هنوز عضو این پروژه نیستند.
                    </p>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        افزودن به پروژه
                    </button>
                </form>
            }
            else
            {
                <p>
                    فردی برای افزودن وجود ندارد؛ همهٔ افراد موجود عضو این
                    پروژه هستند یا هنوز فردی ثبت نشده است.
                </p>

                <a asp-controller="TeamMembers"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    ثبت فرد جدید
                </a>
            }
        </section>
    </div>

    <div class="col-lg-8">
        <section class="panel">
            <div class="panel-heading">
                <h2>تیم پروژه</h2>

                <span class="count-pill">
                    @Model.Members.Count نفر
                </span>
            </div>

            @if (Model.Members.Count == 0)
            {
                <div class="empty-state">
                    <h2>تیم پروژه هنوز خالی است</h2>

                    <p>
                        از فرم افزودن عضو، افراد این پروژه را انتخاب کنید.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">نام عضو</th>
                                <th scope="col">عملیات</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td class="item-title">
                                        @member.FullName
                                    </td>

                                    <td>
                                        <div class="row-actions">
                                            <form asp-controller="ProjectMembers"
                                                  asp-action="Remove"
                                                  method="post"
                                                  data-confirm="این عضو از پروژه حذف شود؟ فرد در سامانه و پروژه‌های دیگر باقی می‌ماند."
                                                  data-prevent-double-submit>

                                                <input type="hidden"
                                                       name="projectId"
                                                       value="@Model.ProjectId" />

                                                <input type="hidden"
                                                       name="membershipId"
                                                       value="@member.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    حذف از پروژه
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <p class="form-text mt-3">
            پیش از حذف عضوی که مسئول تسک است، مسئول تمام تسک‌های او را
            به عضو دیگری تغییر دهید.
        </p>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}