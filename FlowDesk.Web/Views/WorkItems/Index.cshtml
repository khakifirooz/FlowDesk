@using FlowDesk.Domain.Enums
@model FlowDesk.Web.ViewModels.WorkItems.WorkItemIndexViewModel

@{
    ViewData["Title"] = "تسک‌ها";

    string returnUrl =
        $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div dir="rtl" class="mt-4 text-end">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">تسک‌ها</h1>

            <p class="text-muted mb-0">
                مشاهدهٔ کارها، تغییر وضعیت و تعیین مسئول
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="WorkItems"
               asp-action="Assign"
               asp-route-id=""
               class="btn btn-outline-primary">
                واگذاری تسک
            </a>

            <a asp-controller="WorkItems"
               asp-action="Create"
               class="btn btn-primary">
                ایجاد تسک
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <form asp-controller="WorkItems"
          asp-action="Index"
          method="get"
          class="card card-body shadow-sm mb-4">

        <div asp-validation-summary="All"
             class="text-danger mb-2"></div>

        <input type="hidden"
               name="PageNumber"
               value="1" />

        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="SearchText" class="form-label">
                    جست‌وجوی عنوان
                </label>

                <input asp-for="SearchText"
                       class="form-control"
                       placeholder="بخشی از عنوان تسک…" />
            </div>

            <div class="col-md-3">
                <label asp-for="ProjectId" class="form-label">
                    پروژه
                </label>

                <select asp-for="ProjectId"
                        asp-items="Model.Projects"
                        class="form-select">
                    <option value="">همهٔ پروژه‌ها</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="Status" class="form-label">
                    وضعیت
                </label>

                <select asp-for="Status" class="form-select">
                    <option value="">همهٔ وضعیت‌ها</option>

                    <option value="@WorkItemStatus.ToDo">
                        انجام‌نشده
                    </option>

                    <option value="@WorkItemStatus.InProgress">
                        در حال انجام
                    </option>

                    <option value="@WorkItemStatus.Done">
                        انجام‌شده
                    </option>
                </select>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-primary">
                جست‌وجو
            </button>

            <a asp-controller="WorkItems"
               asp-action="Index"
               class="btn btn-outline-secondary">
                پاک‌کردن فیلترها
            </a>
        </div>
    </form>

    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3 text-muted">
        <span>
            تعداد کل نتایج:
            <strong>@Model.TotalCount</strong>
        </span>

        <span>
            تعداد تسک‌های این صفحه:
            <strong>@Model.Items.Count</strong>
        </span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">
            تسکی مطابق فیلترهای انتخاب‌شده پیدا نشد.
        </div>
    }
    else
    {
        <div class="card shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="text-nowrap">
                                شناسه
                            </th>

                            <th scope="col">
                                عنوان
                            </th>

                            <th scope="col">
                                پروژه
                            </th>

                            <th scope="col">
                                مسئول
                            </th>

                            <th scope="col" class="text-nowrap">
                                وضعیت
                            </th>

                            <th scope="col" class="text-nowrap">
                                عملیات
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var statusClass = item.Status switch
                            {
                                WorkItemStatus.ToDo =>
                                    "bg-secondary",

                                WorkItemStatus.InProgress =>
                                    "bg-warning text-dark",

                                WorkItemStatus.Done =>
                                    "bg-success",

                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="text-nowrap">
                                    @item.Id
                                </td>

                                <td class="fw-semibold text-break">
                                    @item.Title
                                </td>

                                <td class="text-break">
                                    @item.ProjectName
                                </td>

                                <td class="text-break">
                                    @item.AssignedMemberName
                                </td>

                                <td>
                                    <span class="badge rounded-pill @statusClass">
                                        @item.StatusText
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap align-items-center gap-2">

                                        <a asp-controller="WorkItems"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary text-nowrap">
                                            ویرایش عنوان
                                        </a>

                                        <a asp-controller="WorkItems"
                                           asp-action="Assign"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary text-nowrap">
                                            تعیین مسئول
                                        </a>

                                        @if (item.Status == WorkItemStatus.ToDo)
                                        {
                                            <form asp-controller="WorkItems"
                                                  asp-action="ChangeStatus"
                                                  method="post"
                                                  class="m-0"
                                                  data-prevent-double-submit>

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <input type="hidden"
                                                       name="targetStatus"
                                                       value="@WorkItemStatus.InProgress" />

                                                <input type="hidden"
                                                       name="returnUrl"
                                                       value="@returnUrl" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-primary text-nowrap">
                                                    شروع
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == WorkItemStatus.InProgress)
                                        {
                                            <form asp-controller="WorkItems"
                                                  asp-action="ChangeStatus"
                                                  method="post"
                                                  class="m-0"
                                                  data-prevent-double-submit>

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <input type="hidden"
                                                       name="targetStatus"
                                                       value="@WorkItemStatus.Done" />

                                                <input type="hidden"
                                                       name="returnUrl"
                                                       value="@returnUrl" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success text-nowrap">
                                                    تکمیل
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == WorkItemStatus.Done)
                                        {
                                            <form asp-controller="WorkItems"
                                                  asp-action="ChangeStatus"
                                                  method="post"
                                                  class="m-0"
                                                  data-prevent-double-submit>

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <input type="hidden"
                                                       name="targetStatus"
                                                       value="@WorkItemStatus.ToDo" />

                                                <input type="hidden"
                                                       name="returnUrl"
                                                       value="@returnUrl" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary text-nowrap">
                                                    بازگشایی
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.TotalCount > 0)
    {
        <nav aria-label="صفحه‌بندی تسک‌ها"
             class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4">

            <span class="text-muted">
                صفحهٔ @Model.PageNumber از @Model.TotalPages
            </span>

            <div class="d-flex gap-2">
                @if (Model.HasPreviousPage)
                {
                    <a asp-controller="WorkItems"
                       asp-action="Index"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-SearchText="@Model.SearchText"
                       asp-route-ProjectId="@Model.ProjectId"
                       asp-route-Status="@Model.Status"
                       class="btn btn-outline-primary">
                        صفحهٔ قبل
                    </a>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-controller="WorkItems"
                       asp-action="Index"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-SearchText="@Model.SearchText"
                       asp-route-ProjectId="@Model.ProjectId"
                       asp-route-Status="@Model.Status"
                       class="btn btn-outline-primary">
                        صفحهٔ بعد
                    </a>
                }
            </div>
        </nav>
    }

</div>