@using FlowDesk.Application.DTOs.WorkItems
@using FlowDesk.Domain.Enums
@using FlowDesk.Web.ViewModels.WorkItems
@using static FlowDesk.Web.Formatting.FlowDeskFormat
@model FlowDesk.Web.ViewModels.WorkItems.WorkItemIndexViewModel
@{
    ViewData["Title"] = Model.Archived ? $"بایگانی · {Model.ScopeLabel}" : Model.ScopeLabel;
    string returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var filterRoute = Model.FilterRoute();
    var pagingRoute = Model.PagingRoute();
    var archiveRoute = new Dictionary<string, string>(pagingRoute);
    archiveRoute.Remove(nameof(Model.Focus));
    if (Model.Archived) archiveRoute.Remove(nameof(Model.Archived));
    else archiveRoute[nameof(Model.Archived)] = "true";
    var projectOnlyRoute = new Dictionary<string, string>(filterRoute);
    if (pagingRoute.TryGetValue(nameof(Model.ProjectId), out string? projectValue))
        projectOnlyRoute[nameof(Model.ProjectId)] = projectValue;
    var activeProjectRoute = new Dictionary<string, string>(projectOnlyRoute);
    activeProjectRoute.Remove(nameof(Model.Archived));
    string? archived = Model.Archived ? "true" : null;
    var scopeNav = new (string Text, bool Active, string? OnlyMine, string? ManagedOnly)[]
    {
        ("همهٔ پروژه‌های من", !Model.ManagedOnly && !Model.OnlyMine, null, null),
        ("تسک‌های من", Model.OnlyMine && !Model.ManagedOnly, "true", null),
        ("پروژه‌های تحت مدیریت", Model.ManagedOnly && !Model.OnlyMine, null, "true")
    };
}

<div class="page-head">
    <div>
        <span class="eyebrow">کارهای تیم</span>
        <h1>@ViewData["Title"]</h1>
        <p>@(Model.OnlyMine ? "تسک‌هایی که به شما واگذار شده‌اند."
            : Model.ManagedOnly ? "تسک‌های پروژه‌هایی که مدیریت می‌کنید."
            : "تسک‌های پروژه‌هایی که در آن‌ها مدیر یا عضو هستید.")</p>
    </div>
    @if (Model.CanCreate && !Model.Archived)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" asp-route-projectId="@Model.ProjectId" class="btn btn-primary">ایجاد تسک</a>
            <a asp-action="Assign" asp-route-id="" asp-route-projectId="@Model.ProjectId" asp-route-returnUrl="@returnUrl" class="btn btn-outline-primary">واگذاری تسک</a>
        </div>
    }
</div>

<nav class="d-flex flex-wrap gap-2 mb-4" aria-label="محدودهٔ تسک‌ها">
    @foreach (var mode in scopeNav)
    {
        if (mode.ManagedOnly is not null && !Model.HasManagedProjects && !Model.ManagedOnly) { continue; }
        <a asp-action="Index" asp-route-OnlyMine="@mode.OnlyMine" asp-route-ManagedOnly="@mode.ManagedOnly"
           asp-route-Archived="@archived" aria-current="@(mode.Active ? "page" : null)"
           class="btn @(mode.Active ? "btn-secondary" : "btn-outline-secondary")">@mode.Text</a>
    }
    <a asp-action="Index" asp-all-route-data="@archiveRoute" class="btn btn-outline-secondary">
        @(Model.Archived ? "بازگشت به تسک‌های فعال" : "بایگانی")
    </a>
</nav>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form asp-action="Index" method="get" class="panel panel-pad mb-4" role="search" aria-label="جست‌وجوی تسک‌ها">
    <div asp-validation-summary="All" class="text-danger"></div>
    @foreach (var entry in filterRoute)
    {
        <input type="hidden" name="@entry.Key" value="@entry.Value" />
    }
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="SearchText" class="form-label">عنوان تسک</label>
            <input asp-for="SearchText" class="form-control" maxlength="200" placeholder="مثلاً طراحی ورود" />
        </div>
        <div class="col-md-3">
            <label asp-for="ProjectId" class="form-label">پروژه</label>
            <select id="ProjectId" name="ProjectId" class="form-select">
                <option value="" selected="@(projectValue is null)">همهٔ پروژه‌های این فهرست</option>
                @foreach (var project in Model.Projects)
                {
                    <option value="@project.Value" selected="@(project.Value == projectValue)">@project.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label">وضعیت</label>
            <select asp-for="Status" class="form-select">
                <option value="">همه</option>
                <option value="@WorkItemStatus.ToDo">انجام‌نشده</option>
                <option value="@WorkItemStatus.InProgress">در حال انجام</option>
                <option value="@WorkItemStatus.Done">انجام‌شده</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="Priority" class="form-label">اولویت</label>
            <select asp-for="Priority" class="form-select">
                <option value="">همه</option>
                @foreach (var priority in Enum.GetValues<WorkItemPriority>())
                {
                    <option value="@priority">@WorkItemLabels.Priority(priority)</option>
                }
            </select>
        </div>
        @if (!Model.Archived)
        {
            <div class="col-md-5">
                <label asp-for="Focus" class="form-label">پیگیری تسک‌های باز</label>
                <select asp-for="Focus" class="form-select">
                    <option value="">همهٔ تسک‌ها</option>
                    <option value="@WorkItemFocus.Overdue">گذشته از موعد</option>
                    <option value="@WorkItemFocus.DueToday">مهلت امروز</option>
                    <option value="@WorkItemFocus.NextSevenDays">مهلت در ۷ روز پیش رو (از امروز)</option>
                    <option value="@WorkItemFocus.WithDeadline">مهلت‌دار</option>
                    <option value="@WorkItemFocus.Unassigned">بدون مسئول</option>
                </select>
            </div>
        }
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" class="btn btn-primary">جست‌وجو</button>
        <a asp-action="Index" asp-all-route-data="@filterRoute" class="btn btn-outline-secondary">پاک‌کردن فیلترها</a>
    </div>
</form>

<p class="text-muted">کل نتایج: @Model.TotalCount — تعداد این صفحه: @Model.Items.Count</p>
<section class="panel task-sheet @(Model.Items.Count > 0 ? "task-sheet-filled" : null)">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            @if (!ViewData.ModelState.IsValid)
            {
                <p>فیلترهای واردشده را بررسی کنید.</p>
            }
            else if (Model.OnlyMine && !Model.HasLinkedMembership)
            {
                <h2>حساب شما هنوز به هیچ پروژه‌ای متصل نیست</h2>
                <p>از مدیر پروژه بخواهید لینک دعوت بفرستد یا حسابتان را به عضویت پروژه متصل کند.</p>
                @if (Model.HasManagedProjects)
                {
                    <a asp-controller="Projects" asp-action="Index">مدیریت اعضا از فهرست پروژه‌ها</a>
                }
            }
            else if (Model.Archived && Model.ArchiveCountBeforeFilters == 0)
            {
                <h2>@(Model.ProjectId.HasValue ? "این پروژه در این فهرست تسک بایگانی‌شده ندارد" : "هنوز تسکی در این بایگانی نیست")</h2>
                <p>تسک انجام‌شده تا زمانی که بایگانی نشود، در فهرست تسک‌های فعال می‌ماند.</p>
                <a asp-action="Index" asp-all-route-data="@activeProjectRoute">دیدن تسک‌های فعال</a>
            }
            else if (Model.Archived && Model.ArchiveCountBeforeFilters > 0)
            {
                <h2>تسک بایگانی‌شده‌ای مطابق این فیلترها پیدا نشد</h2>
                <p>@Number(Model.ArchiveCountBeforeFilters.Value) تسک بایگانی‌شده بدون فیلتر عنوان، وضعیت و اولویت وجود دارد.</p>
                <a asp-action="Index" asp-all-route-data="@projectOnlyRoute">دیدن تسک‌های بایگانی‌شده</a>
            }
            else if (Model.HasFilters)
            {
                <h2>تسکی مطابق این فیلترها پیدا نشد</h2>
                @if (Model.PersonalCountWithoutFilters > 0)
                {
                    <p>@Number(Model.PersonalCountWithoutFilters.Value) تسک من بدون این فیلترها وجود دارد.</p>
                }
                <a asp-action="Index" asp-all-route-data="@filterRoute">پاک‌کردن فیلترها</a>
            }
            else if (Model.Archived)
            {
                <h2>هنوز تسکی در این بایگانی نیست</h2>
                <a asp-action="Index" asp-all-route-data="@archiveRoute">دیدن تسک‌های فعال</a>
            }
            else if (Model.OnlyMine)
            {
                <h2>هنوز تسکی به شما واگذار نشده است</h2>
                <a asp-action="Index">دیدن تسک‌های پروژه‌ها</a>
            }
            else if (Model.CanCreate)
            {
                <h2>هنوز تسکی در این فهرست نیست</h2>
                <a asp-action="Create" class="btn btn-primary">ایجاد اولین تسک</a>
            }
            else
            {
                <h2>هنوز تسکی برای نمایش نیست</h2>
                <a asp-controller="Projects" asp-action="Index">دیدن پروژه‌ها</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="جدول تسک‌ها؛ برای دیدن ستون‌های بیشتر پیمایش کنید" tabindex="0">
            <table class="table align-middle task-table" role="table">
                <thead role="rowgroup"><tr role="row">
                    <th scope="col" role="columnheader">عنوان</th><th scope="col" role="columnheader">پروژه</th><th scope="col" role="columnheader">مسئول</th>
                    <th scope="col" role="columnheader">وضعیت</th><th scope="col" role="columnheader">اولویت</th><th scope="col" role="columnheader">مهلت</th><th scope="col" role="columnheader">عملیات</th>
                </tr></thead>
                <tbody role="rowgroup">
                @foreach (var item in Model.Items)
                {
                    var statusClass = item.Status switch
                    {
                        WorkItemStatus.Done => "status-done",
                        WorkItemStatus.InProgress => "status-progress",
                        _ => "status-todo"
                    };
                    <tr role="row">
                        <th scope="row" role="rowheader" class="text-break task-row-title"><a asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl"><bdi>@item.Title</bdi></a></th>
                        <td role="cell" class="text-break" data-label="پروژه"><bdi>@item.ProjectName</bdi></td>
                        <td role="cell" class="text-break" data-label="مسئول"><bdi>@item.AssignedMemberName</bdi></td>
                        <td role="cell" data-label="وضعیت"><span class="status @statusClass">@item.StatusText</span></td>
                        <td role="cell" data-label="اولویت">@WorkItemLabels.Priority(item.Priority)</td>
                        <td role="cell" data-label="مهلت">
                            @if (item.DueDate is DateOnly dueDate)
                            {
                                <time dir="ltr" class="text-nowrap" datetime="@IsoDate(dueDate)">@PersianDate(dueDate)</time>
                                @if (!Model.Archived && item.Status != WorkItemStatus.Done && dueDate <= Model.Today)
                                {
                                    <span class="status @(dueDate < Model.Today ? "status-late" : "status-progress")">@(dueDate < Model.Today ? "گذشته از موعد" : "امروز")</span>
                                }
                            }
                            else
                            {
                                <span aria-label="بدون مهلت">—</span>
                            }
                        </td>
                        <td role="cell" class="task-row-actions">
                            <div class="d-flex flex-wrap gap-2">
                                @if (item.CanChangeStatus && item.Status is WorkItemStatus.ToDo or WorkItemStatus.InProgress)
                                {
                                    <form asp-action="CompleteTask" method="post" data-prevent-double-submit>
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <input type="hidden" name="returnToList" value="true" />
                                        <button type="submit" class="btn btn-sm btn-primary"
                                                aria-label="تکمیل تسک: @item.Title">انجام شد</button>
                                    </form>
                                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl"
                                       asp-fragment="completion-title" class="btn btn-sm btn-outline-primary">با گزارش</a>
                                }
                                @if (item.CanChangeStatus && item.Status is WorkItemStatus.ToDo or WorkItemStatus.Done)
                                {
                                    var next = WorkItemLabels.NextStatus(item.Status);
                                    <form asp-action="ChangeStatus" method="post" data-prevent-double-submit>
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="targetStatus" value="@next.Target" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="@next.Text تسک @item.Title">@next.Text</button>
                                    </form>
                                }
                                @if (item.CanManage && !Model.Archived)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-secondary">ویرایش</a>
                                    <a asp-action="Assign" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-primary">تعیین مسئول</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.TotalPages > 1)
{
    <nav class="d-flex flex-wrap justify-content-between gap-3 mt-4" aria-label="صفحه‌بندی تسک‌ها">
        <span>صفحهٔ @Model.PageNumber از @Model.TotalPages</span>
        <div class="d-flex gap-2">
            @if (Model.HasPreviousPage)
            {
                <a asp-action="Index" asp-all-route-data="@pagingRoute" asp-route-PageNumber="@(Model.PageNumber - 1)" class="btn btn-outline-secondary">قبلی</a>
            }
            @if (Model.HasNextPage)
            {
                <a asp-action="Index" asp-all-route-data="@pagingRoute" asp-route-PageNumber="@(Model.PageNumber + 1)" class="btn btn-outline-secondary">بعدی</a>
            }
        </div>
    </nav>
}
