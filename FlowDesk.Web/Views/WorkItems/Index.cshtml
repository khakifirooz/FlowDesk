@using FlowDesk.Domain.Enums
@model List<FlowDesk.Web.ViewModels.WorkItems.WorkItemListItemViewModel>

@{
    ViewData["Title"] = "تسک‌ها";
}

<div dir="rtl" class="container mt-4 text-end">
    <h1 class="mb-4">تسک‌ها</h1>

    <a asp-action="Create" class="btn btn-primary mb-3">
        ایجاد تسک
    </a>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            هنوز تسکی ثبت نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>عنوان</th>
                        <th>پروژه</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Title</td>
                            <td>@item.ProjectName</td>
                            <td>@item.StatusText</td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary mb-2">
                                ویرایش عنوان
                            </a>

                            <td>
                                @if (item.Status == WorkItemStatus.ToDo)
                                {
                                    <form asp-controller="WorkItems"
                                          asp-action="ChangeStatus"
                                          method="post">
                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="hidden"
                                               name="targetStatus"
                                               value="@WorkItemStatus.InProgress" />

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">
                                            شروع
                                        </button>
                                    </form>
                                }
                                else if (item.Status == WorkItemStatus.InProgress)
                                {
                                    <form asp-controller="WorkItems"
                                          asp-action="ChangeStatus"
                                          method="post">
                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="hidden"
                                               name="targetStatus"
                                               value="@WorkItemStatus.Done" />

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            تکمیل
                                        </button>
                                    </form>
                                }
                                else if (item.Status == WorkItemStatus.Done)
                                {
                                    <form asp-controller="WorkItems"
                                          asp-action="ChangeStatus"
                                          method="post">
                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="hidden"
                                               name="targetStatus"
                                               value="@WorkItemStatus.ToDo" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            بازگشایی
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>