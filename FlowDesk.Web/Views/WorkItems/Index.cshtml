@using FlowDesk.Domain.Enums
@model FlowDesk.Web.ViewModels.WorkItems.WorkItemIndexViewModel

@{
    ViewData["Title"] = "تسک‌ها";
}

<div dir="rtl" class="container mt-4 text-end">
    <h1 class="mb-4">تسک‌ها</h1>

    <a asp-action="Create" class="btn btn-primary mb-3">
        ایجاد تسک
    </a>

    <form asp-controller="WorkItems"
          asp-action="Index"
          method="get"
          class="card card-body mb-4">

        <div asp-validation-summary="All"
             class="text-danger mb-2"></div>

        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="SearchText" class="form-label">
                    جست‌وجوی عنوان
                </label>

                <input asp-for="SearchText"
                       class="form-control"
                       placeholder="بخشی از عنوان تسک…" />
            </div>

            <div class="col-md-3">
                <label asp-for="ProjectId" class="form-label">
                    پروژه
                </label>

                <select asp-for="ProjectId"
                        asp-items="Model.Projects"
                        class="form-select">
                    <option value="">همهٔ پروژه‌ها</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="Status" class="form-label">
                    وضعیت
                </label>

                <select asp-for="Status" class="form-select">
                    <option value="">همهٔ وضعیت‌ها</option>
                    <option value="@WorkItemStatus.ToDo">
                        انجام‌نشده
                    </option>
                    <option value="@WorkItemStatus.InProgress">
                        در حال انجام
                    </option>
                    <option value="@WorkItemStatus.Done">
                        انجام‌شده
                    </option>
                </select>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                جست‌وجو
            </button>

            <a asp-controller="WorkItems"
               asp-action="Index"
               class="btn btn-outline-secondary">
                پاک‌کردن فیلترها
            </a>
        </div>
    </form>

    <p class="text-muted">
        تعداد نتایج: @Model.Items.Count
    </p>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">
            تسکی مطابق فیلترهای انتخاب‌شده پیدا نشد
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>عنوان</th>
                        <th>پروژه</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Title</td>
                            <td>@item.ProjectName</td>
                            <td>@item.StatusText</td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary mb-2">
                                ویرایش عنوان
                            </a>

                            <td>
                                @if (item.Status == WorkItemStatus.ToDo)
                                {
                                    <form asp-controller="WorkItems"
                                          asp-action="ChangeStatus"
                                          method="post">
                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="hidden"
                                               name="targetStatus"
                                               value="@WorkItemStatus.InProgress" />

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">
                                            شروع
                                        </button>
                                    </form>
                                }
                                else if (item.Status == WorkItemStatus.InProgress)
                                {
                                    <form asp-controller="WorkItems"
                                          asp-action="ChangeStatus"
                                          method="post">
                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="hidden"
                                               name="targetStatus"
                                               value="@WorkItemStatus.Done" />

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            تکمیل
                                        </button>
                                    </form>
                                }
                                else if (item.Status == WorkItemStatus.Done)
                                {
                                    <form asp-controller="WorkItems"
                                          asp-action="ChangeStatus"
                                          method="post">
                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="hidden"
                                               name="targetStatus"
                                               value="@WorkItemStatus.ToDo" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            بازگشایی
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>