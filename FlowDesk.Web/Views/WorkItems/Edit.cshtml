@model FlowDesk.Web.ViewModels.WorkItems.EditWorkItemViewModel

@{
    ViewData["Title"] = "ویرایش عنوان تسک";
}

<div class="page-head">
    <div>
        <span class="eyebrow">تسک‌ها / ویرایش عنوان</span>

        <h1>ویرایش عنوان تسک</h1>

        <p>عنوان کار باید در همین پروژه تکراری نباشد.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        بازگشت به فهرست
    </a>
</div>

<section class="panel panel-pad form-panel">
    <form asp-controller="WorkItems"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          data-prevent-double-submit>

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"></div>

        <div class="mb-4">
            <label asp-for="Title" class="form-label"></label>

            <input asp-for="Title"
                   class="form-control"
                   maxlength="200"
                   autofocus />

            <span asp-validation-for="Title"></span>

            <div class="form-text">
                حداکثر ۲۰۰ کاراکتر
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                ذخیرهٔ عنوان
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                انصراف
            </a>
        </div>
    </form>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
} 