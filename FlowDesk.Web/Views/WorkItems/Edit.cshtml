@using FlowDesk.Domain.Enums
@using FlowDesk.Web.ViewModels.WorkItems
@model FlowDesk.Web.ViewModels.WorkItems.EditWorkItemViewModel

@{
    string backUrl = Model.ReturnUrl ?? Url.Action("Index") ?? "/";
    ViewData["Title"] = "ویرایش تسک";
}

<div class="page-head">
    <div>
        <span class="eyebrow">تسک‌ها / ویرایش</span>

        <h1>ویرایش تسک</h1>

        <p>عنوان کار باید در همین پروژه تکراری نباشد.</p>
    </div>

    <a href="@backUrl" class="btn btn-outline-secondary">
        بازگشت به فهرست
    </a>
</div>

<section class="panel panel-pad form-panel">
    <form asp-controller="WorkItems"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          data-prevent-double-submit>

        <input asp-for="Id" type="hidden" />

        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="mb-4">
            <label asp-for="Title" class="form-label"></label>

            <input asp-for="Title"
                   class="form-control"
                   maxlength="200"
                   autofocus />

            <span asp-validation-for="Title"></span>

            <div class="form-text">
                حداکثر ۲۰۰ کاراکتر
            </div>
        </div>


        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3" maxlength="2000"></textarea>
            <span asp-validation-for="Description"></span>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" class="form-select">
                    @foreach (var priority in Enum.GetValues<WorkItemPriority>())
                    {
                        <option value="@priority">@WorkItemLabels.Priority(priority)</option>
                    }
                </select>
                <span asp-validation-for="Priority"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="DueDate" class="form-label">مهلت (میلادی)</label>
                <input asp-for="DueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" dir="ltr" />
                <span asp-validation-for="DueDate"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                ذخیرهٔ تغییرات
            </button>

            <a href="@backUrl" class="btn btn-outline-secondary">
                انصراف
            </a>
        </div>
    </form>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
} 