@model FlowDesk.Web.ViewModels.TeamMembers.CreateTeamMemberViewModel

@{
    ViewData["Title"] = "ثبت عضو تیم";
}

<div class="page-head">
    <div>
        <span class="eyebrow">اعضای تیم / عضو جدید</span>

        <h1>ثبت عضو تیم</h1>

        <p>
            پس از ثبت فرد، می‌توانید او را به پروژه‌های مربوط اضافه کنید.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        بازگشت به فهرست
    </a>
</div>

<section class="panel panel-pad form-panel">
    <form asp-controller="TeamMembers"
          asp-action="Create"
          method="post"
          data-prevent-double-submit>

        <div asp-validation-summary="ModelOnly"></div>

        <div class="mb-4">
            <label asp-for="FullName" class="form-label"></label>

            <input asp-for="FullName"
                   class="form-control"
                   maxlength="200"
                   autocomplete="name"
                   placeholder="نام و نام خانوادگی"
                   autofocus />

            <span asp-validation-for="FullName"></span>

            <div class="form-text">
                حداکثر ۲۰۰ کاراکتر
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                ثبت عضو
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                انصراف
            </a>
        </div>
    </form>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}